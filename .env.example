PORT=5000

# Auth - the bearer token every request must carry
JWT_TOKEN=change-me-to-a-long-random-string

# DB Config (job log + default source/target for PostGIS operations)
DB_HOST='localhost'
DB_PORT='5432'
DB_NAME='postgres'
DB_USER='postgres'
DB_PASSWORD='postgres'

# s3 Config
awsAccessKeyId=''
awsSecretAccessKey=''
bucketName=''
region='ap-south-1'

# Dask - blank starts an in-process LocalCluster
DASK_SCHEDULER_ADDRESS=''
DASK_WORKERS=4
DASK_THREADS=2
DASK_MEMORY_LIMIT=2GB
DASK_CHUNK_SIZE=20000

# Local output folder for temp storage
OUTPUT_DIR=./output
